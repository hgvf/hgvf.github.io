  "decisions": [
    {
      "phase": "p3",
      "event": "第10集團軍投入",
      "side": "france",
      "commander": "羅貝爾·尼維爾",
      "title": "突破落空，還要打下去嗎？",
      "situation": "五天前的大攻勢沒有帶來承諾的突破：首日平均只推進約550公尺，戰車損失慘重，第5集團軍在運河前受阻；但第6集團軍迫使德軍後撤，香檳群山也已攻下，法軍俘虜約2萬人。",
      "intel": [
        "德軍在山脊上的縱深防禦與反擊師完整",
        "法軍傷亡可能已達13萬",
        "第10集團軍仍可投入",
        "英軍阿拉斯攻勢仍在牽制德軍"
      ],
      "options": [
        {
          "label": "縮小目標，投入第10集團軍繼續進攻"
        },
        {
          "label": "停止攻勢，鞏固已得陣地"
        }
      ],
      "chosen": 0,
      "outcome": "法軍攻下加州高地、拉福磨坊等地，但傷亡持續攀升；5月3日起部隊抗命，攻勢在5月9日放棄。",
      "hindsight": "延續攻勢加劇了士兵的絕望，直接導致譁變與尼維爾去職。",
      "sources": [
        {
