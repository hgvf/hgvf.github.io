  "civilian": {
    "label": "不詳",
    "note": "戰場多為德軍佔領區的鄉村，克拉奧訥等村莊被徹底摧毀；資料未給平民傷亡數字。"
  },
  "significance": [
    "尼維爾「48小時突破」的承諾落空，法軍士氣崩潰，5–6月爆發遍及數十個師的譁變。",
    "貝當以處決少數首謀、改善伙食薪餉休假與只打有限攻勢的方式重建法軍，此後到1918年前不再發動大規模攻勢。",
    "法國戰車首戰暴露了機械可靠性與步戰協同的問題，之後轉向輕型的雷諾 FT。",
    "德軍縱深防禦與反擊師準則在此役證明有效，但拉瑪爾邁松之戰也證明有限目標、砲兵優勢的攻擊可以奏效。",
    "俄國遠征軍參戰後，受國內革命影響也發生騷動。"
  ],
  "facts": [
    {
      "label": "戰車首戰",
      "text": "4月16日是法國戰車的初陣：128輛施奈德戰車中，52輛被砲火擊中、35輛起火燃燒。"
    },
    {
      "label": "120萬人、7,000門砲",
      "text": "蘭斯至魯瓦正面集結的兵力與火砲，規模空前。"
    },
    {
      "label": "第一天550公尺",
      "text": "預期一兩天內突破，第一天平均卻只推進約550公尺。"
    },
    {
      "label": "〈克拉奧訥之歌〉",
      "text": "這場戰役催生了法國士兵的反戰歌曲〈克拉奧訥之歌〉，長期遭到禁唱。"
    }
  ],
