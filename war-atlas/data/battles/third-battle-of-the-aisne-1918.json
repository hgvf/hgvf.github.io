  "significance": [
    "德軍取得1914年以來最大的單日推進，但補給線拉長、預備隊耗盡，突出部成為之後協約國反攻的弱點。",
    "美軍在蒂耶里堡與貝洛森林首度大規模參戰並站穩腳跟，鼓舞了協約國士氣。",
    "貝當撤換杜申，由德古特接掌第6集團軍。",
    "魯登道夫受戰果鼓舞繼續發動攻勢，最終導致第二次馬恩河戰役與德軍的轉折。"
  ],
  "facts": [
    {
      "label": "4小時200萬發",
      "text": "攻勢開始的颶風砲擊約4小時內發射了約200萬發砲彈。"
    },
    {
      "label": "6小時到埃納河",
      "text": "德軍在不到6小時內越過40公里正面攻抵埃納河，橋樑完好落入其手。"
    },
    {
      "label": "第一個獲英勇十字勳章的英國團",
      "text": "德文郡團第2營在比特森林死守，1918年12月獲法國英勇十字勳章附棕櫚。"
    },
    {
      "label": "德皇見俘虜",
      "text": "德皇親赴前線，接見了被俘的英國第150旅旅長、威爾斯人里斯准將。"
