  "civilian": {
    "label": "黑色星期六 3,000 人死傷；戰區大規模破壞",
    "note": "日軍極少收容俘虜，松井日記記載吳淞俘虜 500 人全數槍決；並有掃射難民、攻擊紅十字救護車等暴行。國軍則實施焦土策略，焚毀房屋、田地、水井。"
  },
  "significance": [
    "國軍德械精銳傷亡約六成，黃埔 1929–1937 年訓練的 2.5 萬名基層軍官折損約 1 萬人，中央軍此後未能恢復，蔣中正更依賴地方軍系。",
    "粉碎日方「三月亡華」預期，為工業內遷爭取時間。",
    "史達林格勒之前規模最大的城市戰，被視為現代城市戰的預演；也有史家視其為二戰的起點。",
    "國軍裝甲部隊幾乎全部損失於上海與南京。"
  ],
  "facts": [
    {
      "label": "空軍節",
      "text": "8/14 筧橋空戰後，國府於 1940 年定 8 月 14 日為空軍節。"
    },
    {
      "label": "八百壯士",
      "text": "四行倉庫守軍實際約 411 人，為了震懾敵人對外宣稱八百人。"
    },
    {
      "label": "9 比 1",
      "text": "會戰後期，國軍需 8–12 個師才抵得上日軍 1 個師團的戰力。"
    }
  ],
