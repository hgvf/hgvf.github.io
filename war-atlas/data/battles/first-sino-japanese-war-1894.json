  "civilian": {
    "label": "旅順屠殺；攻台期間約 1.4 萬台灣人死亡（未分軍民）",
    "note": "英文維基 Battle of Lüshunkou：日軍攻下旅順後大規模殺害華人居民，消息傳到西方後重創日本形象（條目未給數字）。攻台期間台灣方面約14,000人死亡（估計）。"
  },
  "significance": [
    "清朝失去對朝鮮的宗主權，東亞以中國為中心的宗藩秩序瓦解，日本取得在朝鮮的主導地位。",
    "台灣與澎湖割讓日本，開始五十年日治；遼東半島因三國干涉退還。",
    "北洋水師覆滅，清廷下令裁撤海軍衙門；洋務運動的成效遭受質疑。",
    "日本躋身列強，賠款與勝利助長其日後與俄國的對抗。"
  ],
  "facts": [
    {
      "label": "看不懂的旗語",
      "text": "北洋水師的信號手冊是英文寫的，能讀懂的軍官不多，黃海海戰中各艦多半只能跟著旗艦行動。"
    },
    {
      "label": "高陞號",
      "text": "載約1,200名清軍的英國輪船高陞號被浪速擊沈，800多人罹難，43名船員只有3人生還。"
    },
    {
      "label": "病比彈更致命",
      "text": "日軍死亡者大多死於疾病：11,894人病死，戰死只有1,132人；攻台時近衛師團病到只剩一半能作戰。"
    },
    {
      "label": "二億兩",
      "text": "馬關條約第四條約定清朝賠償日本二億兩庫平銀。"
    }
  ],
