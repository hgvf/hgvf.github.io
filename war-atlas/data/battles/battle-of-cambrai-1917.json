  "decisions": [
    {
      "phase": "p2",
      "event": "第40師攻擊布爾隆林",
      "side": "british",
      "commander": "道格拉斯·黑格",
      "title": "48 小時期限已過：停手，還是續攻布爾隆？",
      "situation": "黑格戰前設下 48 小時期限：若目標未達成就停止戰役。首日突破成功，但布爾隆嶺仍在德軍手中，騎兵未能擴張，推進自 21 日起明顯放緩，默夫爾與封丹相繼失守。",
      "intel": [
        "黑格視布爾隆嶺為關鍵制高點",
        "原本負責奪取布爾隆的第1騎兵師未能完成任務",
        "第29師被用於確保運河渡口"
      ],
      "options": [
        {
          "label": "續攻布爾隆嶺",
          "detail": "投入第40師與戰車奪取林地與村莊"
        },
        {
          "label": "依 48 小時期限停止並鞏固戰果",
          "detail": "守住首日所得"
        }
      ],
      "chosen": 0,
      "outcome": "第40師 23 日攻入布爾隆林，三天傷亡逾 4,000 人；戰鬥淪為消耗戰，27 日最後一次攻擊後於 28 日停止，部隊疲憊時遭遇 30 日的德軍大反擊。",
      "hindsight": "西線協會文章認為以騎兵奪取布爾隆是最大的作戰失誤；續攻使英軍在德軍反擊時已無預備力量。",
      "sources": [
        {
          "title": "The Battle of Cambrai – Western Front Association",
          "url": "https://www.westernfrontassociation.com/world-war-i-articles/the-battle-of-cambrai-why-did-it-succeed-and-what-went-wrong"
        },
        {
          "title": "Battle of Cambrai (1917) – Wikipedia",
          "url": "https://en.wikipedia.org/wiki/Battle_of_Cambrai_(1917)"
        }
      ]
    },
    {
      "phase": "p4",
      "at": "1917-12-03",
      "side": "british",
      "commander": "道格拉斯·黑格",
      "title": "奪回博納維嶺，還是退到較短防線？",
      "situation": "11 月 30 日德軍反擊奪回南翼大片土地，英軍布爾隆突出部兩側受威脅；12 月 3 日拉瓦克里失守。",
      "intel": [
        "要在博納維嶺重建右翼，需要另一場曠日持久的大規模戰鬥",
        "部隊已在兩週激戰中嚴重消耗"
      ],
      "options": [
        {
          "label": "撤到較緊湊的防線",
          "detail": "放棄布爾隆突出部"
        },
        {
          "label": "發動新攻勢奪回博納維嶺",
          "detail": "恢復右翼原有位置"
        }
      ],
      "chosen": 0,
      "outcome": "撤退自 4/5 日夜進行、12 月 7 日完成，德軍起初未察覺；英軍保住弗萊斯基耶爾一帶的興登堡防線一部。",
      "hindsight": "雙方最終都只保住部分所得，戰役以不分勝負告終。",
      "sources": [
        {
          "title": "Sir Douglas Haig's fifth Despatch (Battle of Cambrai, 1917) – The Long, Long Trail",
          "url": "https://www.longlongtrail.co.uk/?p=3130"
        }
      ]
    }
