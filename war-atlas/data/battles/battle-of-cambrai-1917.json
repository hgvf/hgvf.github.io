  "significance": [
    "首日證明，結合戰車、預測射擊、步兵與飛機的奇襲可以突破堅固的陣地防禦，成為 1918 年聯軍戰法的雛型。",
    "德軍反擊則展示了砲兵、迫擊砲與突擊隊滲透戰術的威力，預告了 1918 年春季攻勢。",
    "首日教堂鳴鐘後兩週內戰果大半丟失，引發英國國內對指揮的調查與質疑。",
    "英國皇家戰車團至今每年舉行「康布雷日」紀念此戰。"
  ],
  "facts": [
    {
      "label": "沒有預備砲擊",
      "text": "1,003 門火砲不經試射直接打出預測彈幕，讓德軍直到戰車出現才知道攻擊來臨。"
    },
    {
      "label": "為勝利鳴鐘",
      "text": "首日突破 8 公里，消息傳回英國時各地教堂鳴鐘慶祝，兩週後戰果卻大半丟失。"
    },
    {
      "label": "孤膽砲手的傳說",
      "text": "黑格報告提到弗萊斯基耶爾一名德軍砲兵軍官獨自操砲至陣亡；今日史家認為這是迷思，實際是第108野戰砲兵團的反戰車部署。"
    },
    {
      "label": "被壓垮的橋",
      "text": "馬斯尼耶爾的運河橋在一輛戰車重壓下坍塌，騎兵擴張的機會隨之消失。"
    }
  ],
