  "result": {
    "winner": "allies",
    "label": "盟軍勝利",
    "detail": "美軍佔領沖繩，取得距日本本土約 340 英里的前進機場與錨地；戰役的慘烈傷亡成為美方決定使用原子彈、避免登陸本土的重要考量之一。"
  },
  "summary": "太平洋戰爭規模最大的兩棲登陸與最後一場大型戰役。美軍第十軍團幾乎無抵抗地登上嘉手納海灘，隨後在首里防線前與日軍第32軍展開長達兩個月的洞窟與高地爭奪；海上則承受日軍史上規模最大的神風特攻，大和號也在出擊途中被擊沉。沖繩平民死亡估計 4.2 萬至 15 萬人。",
  "background": [
    {
      "title": "跳島戰略的終點",
      "text": "盟軍逐島逼近日本，計畫奪取沖繩作為空襲與登陸日本本土（沒落行動）的跳板。"
    },
    {
      "title": "牛島滿的持久戰",
      "text": "日軍判斷無力守住全島，放棄灘頭決戰，把兵力集中於南部首里古城周邊的陡峭稜線，利用洞窟與反斜面工事拖延美軍。"
    },
    {
      "title": "第9師團調走",
      "text": "原駐沖繩的第9師團在戰前被調往台灣，被視為日軍防衛計畫的一大失誤。"
    },
    {
      "title": "動員平民",
      "text": "日軍徵召約 4 萬名沖繩人入伍，3 月組成姬百合學徒隊（222 名女學生、18 名教師）擔任陸軍醫院護理。"
    }
  ],
  "objectives": {
    "allies": "奪取沖繩全島與周邊機場、錨地，作為進攻日本本土的基地。",
    "japan": "以地面持久戰加神風特攻盡量消耗美軍艦隊與兵力，延遲本土登陸。"
  },
