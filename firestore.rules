rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWhitelisted() {
      return isSignedIn() &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/auth).data.allowed_emails;
    }

    match /sectors/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /subsectors/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /tickers/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /analysis/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /research_notes/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /prices/{symbol} {
      allow read: if true;
      allow write: if false;
    }
    // Reports — populated server-side via the Firebase Admin SDK
    // (scripts/publish.py), which bypasses these rules. Public read so the
    // pages render on any device without login; no client writes.
    match /supply_chain_news/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /earnings_calls/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /annual_reports/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // ── Military zone ──────────────────────────────────────────
    // Daily procurement/contract events. Whitelisted users publish via the
    // "ADD JSON" importer (mirrors earnings_calls / annual_reports).
    match /mil_defense_daily/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // Daily LLM digest. Written ONLY by the Cloudflare Worker via a Google
    // service account (which bypasses these rules); clients are read-only.
    match /mil_feeds/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/auth {
      allow read: if isSignedIn();
      allow write: if isWhitelisted();
    }
    match /config/worker {
      allow read: if isWhitelisted();
      allow write: if false;
    }
  }
}
