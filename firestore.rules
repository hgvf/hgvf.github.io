rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWhitelisted() {
      return isSignedIn() &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/auth).data.allowed_emails;
    }

    match /sectors/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /subsectors/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /tickers/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /analysis/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /research_notes/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /prices/{symbol} {
      allow read: if true;
      allow write: if false;
    }
    // Precomputed lookup indexes (e.g. indexes/ticker_events — symbol → latest
    // related supply/industry/earnings doc). Maintained server-side by
    // scripts/publish.py (Admin/REST, bypasses rules); public read so cards
    // render without login, whitelisted client writes as a fallback.
    match /indexes/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // Manual company-name overrides for tickers whose auto-fetched name is
    // wrong. Kept separate from prices/ (which is locked and overwritten by the
    // price refresh) so a correction survives. Whitelisted admins may write.
    match /ticker_overrides/{symbol} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // Reports — populated server-side via the Firebase Admin SDK
    // (scripts/publish.py), which bypasses these rules. Public read so the
    // pages render on any device without login; no client writes.
    match /supply_chain_news/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // 產業消息 (supply-chain-intelligence-daily skill) — structural
    // supply-chain events + a per-day digest. Written server-side by
    // scripts/publish.py --type events (Admin/REST, bypasses rules);
    // public read so the page renders without login, whitelisted client writes.
    match /supply_chain_events/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /supply_chain_daily_digest/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /earnings_calls/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /annual_reports/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // ── Military zone ──────────────────────────────────────────
    // Daily procurement/contract events. Whitelisted users publish via the
    // "ADD JSON" importer (mirrors earnings_calls / annual_reports).
    match /mil_defense_daily/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // Wars/battles (② 戰役消耗帳) and weapons lineage (③ 系統譜系),
    // inserted by whitelisted users via the "ADD JSON" importers.
    match /mil_conflicts/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /mil_weapons/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    match /mil_weapons_modern/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // Family display overrides (③ 系統譜系 改名／改國家), whitelist writes.
    match /mil_families/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }

    // ── News section ───────────────────────────────────────────
    // 軍武動態（military-dynamics-intelligence skill）— 全球軍事事件、演習、
    // 部署與地圖資料。Whitelisted users publish via the "ADD JSON" importer;
    // downstream ETL may also write server-side (Admin/REST, bypasses rules).
    match /military_news/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // 產業動態（industry-news-daily skill）— 科技產業／價值鏈事件與投資內容節點。
    match /industry_news/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }

    // Editable site content (home 頁 About Me / Interests 等)。公開讀，白名單寫。
    match /site_content/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // 重點新聞收藏 — 跨裝置 / 跨帳號共用同一份收藏清單。公開讀，白名單寫。
    match /highlight_collected/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }
    // 事實追蹤 — 從法說事實 / 未來看點收藏出的可驗證投資假設與其進度更新。
    // 跨裝置 / 跨帳號共用同一份清單。公開讀，白名單寫。
    match /tracked_facts/{id} {
      allow read: if true;
      allow write: if isWhitelisted();
    }

    match /config/auth {
      allow read: if isSignedIn();
      allow write: if isWhitelisted();
    }
    match /config/worker {
      allow read: if isWhitelisted();
      allow write: if false;
    }
  }
}
